@gooo schema="gooo/improvement-proposer/v1"
@gooo denominator="gooo-improvement-proposer-v1"
activity id="cell-01" activity="ObserveLedgerRelease" claim_id="claim/ledger-release" operation_id="observe-ledger-release" stage="LEDGER_OBSERVATION" step="READ_IMMUTABLE_RELEASE" proof_choice="FOUNDATION" indicator_class="DRIVER"
activity id="cell-02" activity="BindLedgerDigest" claim_id="claim/ledger-digest" operation_id="bind-ledger-digest" stage="LEDGER_BINDING" step="MATCH_RELEASE_DIGEST" proof_choice="FOUNDATION" indicator_class="DRIVER"
activity id="cell-03" activity="ValidateCapabilityRecord" claim_id="claim/capability-record" operation_id="validate-capability-record" stage="EVIDENCE_VALIDATION" step="READ_EXACT_CAPABILITY_RECORD" proof_choice="FOUNDATION" indicator_class="DRIVER"
activity id="cell-04" activity="ValidateCounterexampleRecord" claim_id="claim/counterexample-record" operation_id="validate-counterexample-record" stage="EVIDENCE_VALIDATION" step="READ_EXACT_COUNTEREXAMPLE_RECORD" proof_choice="FOUNDATION" indicator_class="DRIVER"
activity id="cell-05" activity="ValidateUtilityRecord" claim_id="claim/utility-record" operation_id="validate-utility-record" stage="EVIDENCE_VALIDATION" step="REQUIRE_EXACT_BEFORE_AFTER" proof_choice="COHERENCE" indicator_class="OUTCOME"
activity id="cell-06" activity="DeriveCausalSourceCells" claim_id="claim/causal-source-cells" operation_id="derive-causal-source-cells" stage="CAUSAL_DERIVATION" step="BIND_SOURCE_CELL_EDGES" proof_choice="COHERENCE" indicator_class="OUTCOME"
activity id="cell-07" activity="BoundCandidateSet" claim_id="claim/bounded-candidates" operation_id="bound-candidate-set" stage="CANDIDATE_DERIVATION" step="ENFORCE_MAXIMUM_SET" proof_choice="COHERENCE" indicator_class="OUTCOME"
activity id="cell-08" activity="BindExpectedEvidence" claim_id="claim/expected-evidence" operation_id="bind-expected-evidence" stage="CANDIDATE_DERIVATION" step="EMIT_EVIDENCE_TYPE" proof_choice="COHERENCE" indicator_class="OUTCOME"
activity id="cell-09" activity="EnforcePermittedAuthority" claim_id="claim/permitted-authority" operation_id="enforce-permitted-authority" stage="AUTHORITY_GUARDRAIL" step="DENY_REPOSITORY_AND_PR_MUTATION" proof_choice="REGRESSION" indicator_class="GUARDRAIL"
activity id="cell-10" activity="DeriveFalsifier" claim_id="claim/falsifier" operation_id="derive-falsifier" stage="CANDIDATE_DERIVATION" step="EMIT_EXACT_FALSIFIER" proof_choice="REGRESSION" indicator_class="GUARDRAIL"
activity id="cell-11" activity="EmitReplayReceipt" claim_id="claim/replay-receipt" operation_id="emit-replay-receipt" stage="REPLAY" step="BIND_DETERMINISTIC_OUTPUTS" proof_choice="REGRESSION" indicator_class="GUARDRAIL"
activity id="cell-12" activity="PreserveCandidateEvent" claim_id="claim/candidate-event" operation_id="preserve-candidate-event" stage="REPLAY" step="CHAIN_CANDIDATE_EVENTS" proof_choice="REGRESSION" indicator_class="GUARDRAIL"
